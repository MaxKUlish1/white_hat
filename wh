#!/usr/bin/env bash
# wh — пульт white_hat. Каждое действие пишется в журнал (цепочка хэшей) и коммитится.
# Сеть — только адреса из scope.txt. Ничего не ставит на чужие серверы, только чтение.
WH="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "$WH/env.sh"
cd "$WH" || exit 1
KEY="$WH/keys/wh_ed25519"; KH="$WH/keys/known_hosts"; TS=$(date +%F_%H%M)
J()   { python3 "$WH/nadzor.py" human "$*"; }
say() { printf "\n\033[1;36m▶ %s\033[0m\n" "$*"; }
need(){ [ -n "$1" ] || { echo "нужен IP: wh $CMD <IP>"; exit 2; }
        python3 "$WH/guard.py" inscope "$1" || { echo "СТОП: $1 нет в scope.txt (добавь: wh start $1)"; J "отказ: $CMD $1 — вне области"; exit 3; }; }
SSHO=(-o UserKnownHostsFile="$KH" -o StrictHostKeyChecking=ask -o ConnectTimeout=10 -o PreferredAuthentications=publickey,keyboard-interactive,password)
[ -f "$KEY" ] && SSHO=(-i "$KEY" "${SSHO[@]}")
CMD="${1:-help}"; shift
case "$CMD" in
  start)  # wh start <IP> [логин] — область + клятва
    [ -n "$1" ] || { echo "wh start <IP>"; exit 2; }
    python3 -c "import ipaddress,sys; n=ipaddress.ip_network(sys.argv[1],strict=False); sys.exit(0 if n.prefixlen>=24 else 1)" "$1" 2>/dev/null || { echo "СТОП: нужен IP или подсеть не шире /24 (например 10.1.2.3 или 10.1.2.0/24)"; exit 2; }
    grep -qxF "$1" scope.txt || echo "$1" >> scope.txt
    [ -n "$2" ] && echo "$2" > keys/login
    if [ ! -s projects/.current ]; then "$WH/wh" project new "$(echo "$1" | tr '/' '_')" "проверка версий ПО и настроек сервера $1 (только чтение)" >/dev/null; fi
    say "Проект открыт: $(cat projects/.current). ИИ работает по проектам сам: wh project list / new / use."
    say "Область работ: только $1. Всё остальное программа откажется трогать — и я, и ИИ."
    J "start: $1 добавлен в область${2:+, логин $2}"; echo "область: $(grep -v '^#' scope.txt | tr '\n' ' ')";;
  key)    # wh key — свой ключ SSH (публичную часть отдать админу)
    [ -f "$KEY" ] || ssh-keygen -q -t ed25519 -N "" -C "white_hat@$(hostname)-$(date +%F)" -f "$KEY"
    echo "ПУБЛИЧНЫЙ ключ (отдать админу для authorized_keys):"; cat "$KEY.pub"; ssh-keygen -lf "$KEY.pub"
    J "key: показан публичный ключ $(ssh-keygen -lf "$KEY.pub" | cut -d' ' -f2)";;
  fp)     # wh fp <IP> — отпечаток ключа сервера (сверить с админом ДО входа)
    need "$1"; say "Снимаю отпечаток ключа сервера $1. Сверьте со своим — так исключаем подмену сервера. Вход не выполняется."
    ssh-keyscan -T 5 -p "${2:-22}" "$1" 2>/dev/null | tee "out/hostkeys_$1.txt" | ssh-keygen -lf - | tee "out/fingerprint_$1.txt"
    J "fp: отпечатки ключей сервера $1 сняты";;
  ssh)    # wh ssh <IP> [логин] — вход, сессия записывается
    need "$1"; L="${2:-$(cat keys/login 2>/dev/null)}"; [ -n "$L" ] || { echo "wh ssh <IP> <логин>"; exit 2; }
    J "ssh: вход $L@$1"; script -q -f -c "$(printf "%q " ssh "${SSHO[@]}" "$L@$1")" "logs/ssh_$1_$TS.log"
    python3 nadzor.py add "logs/ssh_$1_$TS.log" "лог ssh-сессии $1";;
  versions) # wh versions <IP> [логин] — снять версии (только чтение) и сверить
    need "$1"; L="${2:-$(cat keys/login 2>/dev/null)}"; [ -n "$L" ] || { echo "wh versions <IP> <логин>"; exit 2; }
    F="out/versions_$1_$TS.txt"; J "versions: сбор версий $L@$1 (version.sh, только чтение)"
    say "Шаг 1/2: снимаю с $1 список установленных пакетов и настроек. Только чтение, на сервере ничего не создаётся."
    ssh -p "${3:-22}" "${SSHO[@]}" "$L@$1" 'sh -s' < version.sh > "$F" && [ -s "$F" ] && echo "получено: $F ($(wc -l < "$F") строк)" && say "Шаг 2/2: сверяю версии с открытой базой уязвимостей у себя на ноутбуке. Сервер не трогаю." && if [ -n "$WH_OFFLINE" ]; then python3 check.py --offline "$F"; else python3 check.py "$F"; fi
    J "versions: готово $1";;
  cve)    # wh cve <CVE-ID> — что это за уязвимость (офлайн, локальная база grype)
    [ -n "$1" ] || { echo "wh cve CVE-2023-48795"; exit 2; }
    grype db search vuln "$1" -o json 2>/dev/null | python3 -c '
import sys, json, textwrap
d = json.load(sys.stdin); d = d if isinstance(d, list) else d.get("vulnerabilities", [d])
if not d: print("нет в локальной базе"); sys.exit()
x = d[0]; sev = [s for s in (x.get("severities") or []) if isinstance(s, dict)]
print(x.get("id"), "| опубликовано:", (x.get("published_date") or x.get("published") or "?")[:10])
for s in sev[:2]:
    v = s.get("value") or {}; print("  оценка:", s.get("scheme", ""), v.get("base_score", ""), v.get("vector", "") if isinstance(v, dict) else v)
print(textwrap.fill(x.get("description", ""), 110))'
    J "cve: $1";;
  check)  if [ "$1" = "--offline" ]; then python3 check.py --offline "$2"; else python3 check.py "$1"; fi; J "check: $*";;
  tls)    # wh tls <IP> [порт] — HTTPS: протоколы, шифры, сертификат
    need "$1"; say "Проверяю HTTPS на $1: протоколы, шифры, сертификат. Обычные подключения, без атак."; J "tls: testssl $1:${2:-443} ${3}"
    if [ -n "$3" ]; then testssl.sh --quiet --color 0 --warnings off --ip "$1" --logfile "out/tls_$1_$TS.log" "$3:${2:-443}"; else testssl.sh --quiet --color 0 --warnings off --logfile "out/tls_$1_$TS.log" "$1:${2:-443}"; fi; J "tls: готово $1";;
  sshaudit) need "$1"; say "Проверяю настройки SSH на $1: только рукопожатие, без входа и без подбора паролей."; J "sshaudit: $1"; ssh-audit -n -p "${2:-22}" "$1" | tee "out/sshaudit_$1_$TS.txt"; J "sshaudit: готово $1";;
  web)    # wh web <IP> — что за веб: код ответа, заголовок, сервер, технологии (по 1 запросу)
    need "$1"; T="$1"
    if [ -n "$2" ]; then R=$(python3 -c "import socket,sys;print(' '.join(sorted({a[4][0] for a in socket.getaddrinfo(sys.argv[1],443)})))" "$2" 2>/dev/null)
      echo " $R " | grep -q " $1 " || { echo "СТОП: имя $2 указывает на [${R:-не найдено}], а не на $1 — это может быть чужой сервер. Проверяю только по IP."; J "отказ: web $2 -> $R (не $1)"; set -- "$1"; }
      [ -n "$2" ] && T="$2"; fi
    say "Смотрю, что за веб на $T: по одному запросу на http и https."; J "web: httpx $T ($1)"; printf 'http://%s\nhttps://%s\n' "$T" "$T" | httpx -silent -nc -sc -title -server -td -rl 5 | tee "out/web_$1_$TS.txt"; J "web: готово $1";;
  nuclei) # wh nuclei <IP> — ТОЛЬКО по отдельному разрешению: без dos/fuzz/intrusive, 10 запросов/с
    need "$1"; read -r -p "Есть отдельное разрешение админа на nuclei по $1? (да/нет) " a </dev/tty; [ "$a" = "да" ] || exit 0
    J "nuclei: $1 (безопасный режим)"; nuclei -duc -silent -nc -t tools/cache/nuclei-templates -etags dos,fuzz,intrusive -rl 10 -c 5 -severity low,medium,high,critical -u "https://$1" -o "out/nuclei_$1_$TS.txt"; J "nuclei: готово $1";;
  code)   # wh code <папка> — разбор кода у себя: semgrep + gitleaks + trivy
    [ -d "$1" ] || { echo "wh code <папка с кодом>"; exit 2; }; N=$(basename "$1"); J "code: разбор $1"
    semgrep scan --config auto --metrics off --quiet --json -o "out/semgrep_$N.json" "$1" >/dev/null 2>&1; echo "semgrep: $(python3 -c "import json;print(len(json.load(open('out/semgrep_$N.json'))['results']))") находок"
    gitleaks dir "$1" --no-banner --redact -r "out/gitleaks_$N.json" 2>&1 | tail -n 1
    trivy fs --quiet --scanners vuln,secret,misconfig "$1" | tee "out/trivy_$N.txt" | grep -E "Total:" ; J "code: готово $1";;
  shell)  # wh shell — терминал, где КАЖДАЯ твоя команда пишется в журнал, сессия записывается
    J "shell: открыт терминал под надзором"; script -q -f -c "bash --rcfile $WH/tools/whrc" "logs/shell_$TS.log"
    python3 nadzor.py add "logs/shell_$TS.log" "лог терминала";;
  winversions) # wh winversions <IP> [логин] — Windows-сервер с OpenSSH: версии ПО (только чтение)
    need "$1"; L="${2:-$(cat keys/login 2>/dev/null)}"; [ -n "$L" ] || { echo "wh winversions <IP> <логин>"; exit 2; }
    F="out/versions_win_$1_$TS.txt"; J "winversions: сбор ПО Windows $L@$1 (только чтение)"
    ssh "${SSHO[@]}" "$L@$1" "powershell -NoProfile -Command -" < version.ps1 > /dev/null
    ssh "${SSHO[@]}" "$L@$1" "powershell -NoProfile -Command \"Get-Content (Get-ChildItem versions_*.txt | Sort-Object LastWriteTime | Select-Object -Last 1)\"" > "$F" && python3 check.py "$F"
    J "winversions: готово $1 (на сервере остался файл versions_*.txt в домашней папке — сказать админу)";;
  doctor) # wh doctor — готовность: инструменты, ключ, базы, интернет, журнал
    ok(){ printf '  %-34s %s\n' "$1" "$2"; }
    for t in osv-scanner trivy grype syft semgrep gitleaks testssl.sh ssh-audit httpx nuclei subfinder; do command -v $t >/dev/null && ok "$t" "есть" || ok "$t" "НЕТ"; done
    [ -f "$KEY.pub" ] && ok "ключ SSH" "$(ssh-keygen -lf "$KEY.pub" | cut -d' ' -f2)" || ok "ключ SSH" "нет (wh key)"
    ok "область scope.txt" "$(grep -v '^#' scope.txt | tr '\n' ' ' | sed 's/^$/пусто (wh start IP)/')"
    ok "задача (клятва)" "$(cat task.txt 2>/dev/null || echo 'нет — ИИ только читает; дать: wh start IP')"
    ok "текущий проект" "$(cat projects/.current 2>/dev/null || echo 'нет')"
    ok "приоритеты KEV / EPSS" "$(python3 -c 'import json;k=json.load(open("tools/cache/kev.json"));print("KEV",k["catalogVersion"])' 2>/dev/null || echo нет) · EPSS $(ls -l --time-style=+%F tools/cache/epss.csv.gz 2>/dev/null | awk '{print $6}')"
    ok "база trivy / grype / nuclei" "$(du -sh tools/cache/trivy tools/cache/grype tools/cache/nuclei-templates 2>/dev/null | awk '{print $1}' | tr '\n' ' ')"
    ok "интернет (OSV)" "$(curl -s -m 6 -o /dev/null -w '%{http_code}' https://api.osv.dev/v1/vulns/DSA-5000-1 | sed 's/200/есть/;s/000/НЕТ — сверка дома/')"
    ok "надзор ИИ (хуки)" "$(grep -c guard.py .claude/settings.json) сторож, $(grep -c nadzor.py .claude/settings.json) капсулы"
    ok "журнал" "$(python3 nadzor.py verify 2>&1 | tail -n1)";;
  demo)   # wh demo — показ офлайн: сторож, капсулы, цепочка хэшей (отдельный демо-журнал)
    export WH_JOURNAL="$WH/out/demo_journal.tsv"; rm -f "$WH_JOURNAL"
    echo "1) Сторож ИИ решает ДО выполнения:"
    for c in '{"tool_name":"Bash","tool_input":{"command":"nmap -sV 10.0.0.0/24"}}' '{"tool_name":"Bash","tool_input":{"command":"ssh admin@8.8.8.8 uname -a"}}' '{"tool_name":"Bash","tool_input":{"command":"sudo systemctl restart nginx"}}' '{"tool_name":"Write","tool_input":{"file_path":"/etc/ssh/sshd_config"}}' '{"tool_name":"Bash","tool_input":{"command":"python3 check.py пример_выгрузки.txt"}}'; do
      r=$(echo "$c" | python3 guard.py); printf '   %-62s -> %s\n' "$(echo "$c" | python3 -c 'import sys,json;d=json.load(sys.stdin);i=d["tool_input"];print(d["tool_name"],i.get("command") or i.get("file_path"))')" "$( [ -n "$r" ] && echo "$r" | python3 -c 'import sys,json;print("ЗАПРЕТ:",json.load(sys.stdin)["hookSpecificOutput"]["permissionDecisionReason"].split(": ",1)[1])' || echo разрешено)"; done
    echo "2) Журнал — цепочка хэшей:"; python3 nadzor.py log 5; python3 nadzor.py verify
    echo "3) Подделка: меняю одну запись задним числом…"; sed -i '2s/ЗАПРЕЩЕНО/разрешено/' "$WH_JOURNAL"; python3 nadzor.py verify
    echo "4) Пример отчёта сверки реального сервера: пример_отчёта_мой_сервер.md (775 пакетов, 16 к обновлению)";;
  outside) # wh outside <IP> — проверка СНАРУЖИ без логина: версия по баннеру SSH -> сверка; веб — раскрытые версии
    need "$1"; say "Проверка снаружи, без входа: рукопожатие SSH и по одному запросу на http/https. Сканирования нет."
    J "outside: $1"; B=$(timeout 8 bash -c 'exec 3<>/dev/tcp/$0/$1; head -n1 <&3' "$1" "${2:-22}" 2>/dev/null | tr -d '\r')
    [ -n "$B" ] && echo "SSH: $B" || echo "SSH: порт ${2:-22} не отвечает"
    printf 'http://%s\nhttps://%s\n' "$1" "$1" | timeout 40 httpx -silent -nc -sc -title -server -td -rl 5 > "out/web_$1_$TS.txt" 2>/dev/null; cat "out/web_$1_$TS.txt"
    python3 check.py --outside "$1" "$B" "out/web_$1_$TS.txt"; J "outside: готово $1";;
  menu)   # wh menu — экран с пунктами: выбрал цифру — он спросит IP и запустит
    ask(){ read -r -p "$1" REPLY </dev/tty; echo "$REPLY"; }
    while true; do
      clear 2>/dev/null
      printf '\033[1;32m'
      cat <<'ART'
 ╔════════════════════════════════════════════════════════════════╗
 ║   W H I T E _ H A T      проверка серверов только чтением       ║
 ║   версии ПО · настройки · уязвимости (офлайн) · отчёт админу   ║
 ║   ИИ под надзором: сторож до каждого действия · журнал SHA-256 ║
 ╚════════════════════════════════════════════════════════════════╝
ART
      printf '\033[0m\n'
      A=$(grep -v '^#' scope.txt | tr '\n' ' '); P=$(cat projects/.current 2>/dev/null)
      echo "  область: ${A:-— пусто (пункт 1) —}   проект: ${P:-—}   клятва: $( [ -f task.txt ] && echo есть || echo 'нет — ИИ только читает')"
      echo "  журнал: $(python3 nadzor.py verify 2>&1 | tail -n1 | cut -c1-90)"
      cat <<'M'

   g  ★ ПОШАГОВО — мастер: ведёт сам, ничего не забудешь

   1  Начать: IP от админа в область          7  Что за уязвимость (CVE)
   2  План работ для админа                   8  Итог + хэш журнала
   3  Проверка СНАРУЖИ, без логина            9  Журнал (последние записи)
   4  Проверка версий (дали логин)            d  Готовность (doctor)
   5  Настройки SSH                           s  Схема «как работает» (браузер)
   6  HTTPS                                   o  Открыть отчёт в браузере
                                              p  Проекты (клятвы)
                                              c  Позвать ИИ-агента (claude)
                                              0  Выход
M
      k=$(ask "  выбор: ")
      case "$k" in
        g) "$WH/wh" go;;
        1) ip=$(ask "  IP: "); lg=$(ask "  логин (Enter — нет): "); "$WH/wh" start "$ip" $lg;;
        2) "$WH/wh" plan "$(ask '  IP: ')";;
        3) "$WH/wh" outside "$(ask '  IP: ')";;
        4) ip=$(ask "  IP: "); lg=$(ask "  логин: "); "$WH/wh" fp "$ip"; echo; ok=$(ask "  отпечаток сверили с админом? (да/нет) "); [ "$ok" = "да" ] && "$WH/wh" versions "$ip" "$lg";;
        5) "$WH/wh" sshaudit "$(ask '  IP: ')";;
        6) "$WH/wh" tls "$(ask '  IP: ')";;
        7) "$WH/wh" cve "$(ask '  CVE (например CVE-2023-48795): ')";;
        8) "$WH/wh" report;;
        o) "$WH/wh" open;;
        9) "$WH/wh" log 25;;
        p) "$WH/wh" project list;;
        d) "$WH/wh" doctor;;
        s) "$WH/wh" about;;
        c) J "menu: запущен ИИ-агент"; (cd "$WH" && claude);;
        0|q) break;;
      esac
      ask $'\n  Enter — назад в меню ' >/dev/null
    done;;
  publish) # wh publish [--dry] — обновить публичную копию на GitHub: только код и описание, с проверкой на утечки
    F="README.md wh guard.py nadzor.py check.py jlog.py version.sh version.ps1 env.sh tools/fetch.py tools/whrc .claude/settings.json about.html ПАМЯТКА.md demo/README.md пример_отчёта.md пример_выгрузки.txt .gitignore"
    export GIT_INDEX_FILE="$WH/.git/index_public"; git read-tree public && git add $F && TREE=$(git write-tree)
    BAD=$(git grep -n -I -E "192[.]168[.]|nod[e]2|BEGIN [A-Z ]*PRIVAT[E] KEY|ssh-(ed25519|rsa) AAA[A]|gh[pousr]_[A-Za-z0-9]{30}|[A-Za-z0-9._-]+@gmai[l][.]com" $TREE -- . 2>/dev/null | head -n 5)
    if [ -n "$BAD" ]; then unset GIT_INDEX_FILE; echo "СТОП: похоже на личные данные, не публикую:"; echo "$BAD"; exit 4; fi
    if [ "$(git rev-parse public^{tree})" = "$TREE" ]; then unset GIT_INDEX_FILE; echo "публичная копия уже актуальна"; exit 0; fi
    C=$(git commit-tree "$TREE" -p public -m "обновление $(date '+%F %H:%M')"); unset GIT_INDEX_FILE
    git update-ref refs/heads/public "$C"; echo "ветка public обновлена: $(git diff --stat public~1 public | tail -n1)"
    [ "$1" = "--dry" ] && { echo "(--dry: на GitHub не отправлено)"; exit 0; }
    git push https://github.com/MaxKUlish1/white_hat.git public:main && J "publish: GitHub обновлён"
    echo "https://github.com/MaxKUlish1/white_hat";;
  open)   # wh open — открыть последний красивый отчёт (HTML) в браузере
    H=$(ls -t report_*.html out/ИТОГ_*.html 2>/dev/null | head -n1); [ -n "$H" ] || { echo "отчётов ещё нет"; exit 1; }
    echo "открываю: $H"; J "open: $H"; (xdg-open "$H" || firefox "$H") >/dev/null 2>&1 &;;
  update-db) # wh update-db — обновить офлайн-базы (нужен интернет): KEV, EPSS, trivy, grype, шаблоны nuclei
    J "update-db: обновление баз"
    curl -sfL -m 60 -o tools/cache/kev.json.new https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json && mv tools/cache/kev.json.new tools/cache/kev.json && echo "KEV: ok"
    curl -sfL -m 180 -o tools/cache/epss.csv.gz.new https://epss.empiricalsecurity.com/epss_scores-current.csv.gz && mv tools/cache/epss.csv.gz.new tools/cache/epss.csv.gz && echo "EPSS: ok"
    trivy image --download-db-only --quiet && echo "trivy: ok"; grype db update -q && echo "grype: ok"
    nuclei -duc -update-templates -ud tools/cache/nuclei-templates -silent >/dev/null 2>&1 && echo "nuclei: ok"; J "update-db: готово";;
  project) # wh project new <имя> "<чем занимаюсь>" | use <имя> | list — проекты с клятвой (ИИ ведёт их сам)
    sub="${1:-list}"; shift
    case "$sub" in
      new) n="$1"; g="$2"
           [[ "$n" =~ ^[A-Za-z0-9._-]{1,40}$ ]] || { echo "имя проекта: латиница, цифры, . _ - (до 40)"; exit 2; }
           [ -n "$g" ] || { echo 'wh project new <имя> "<чем занимаюсь>"'; exit 2; }
           [ -d "projects/$n" ] && { echo "проект $n уже есть — открыть: wh project use $n"; exit 3; }
           mkdir -p "projects/$n"
           printf '# Проект %s\n\nКлятва: я занимаюсь: %s — и ничем другим\nСоздан: %s\n\n## Ход работы\n' "$n" "$g" "$(date '+%F %H:%M')" > "projects/$n/README.md"
           echo "$n" > projects/.current; python3 nadzor.py task "проект $n: $g" >/dev/null
           say "Проект $n создан и открыт. Клятва: я занимаюсь: $g — и ничем другим"; J "project new: $n — $g";;
      use) n="$1"; [ -d "projects/$n" ] || { echo "нет проекта $n — список: wh project list"; exit 3; }
           g=$(sed -n 's/^Клятва: я занимаюсь: \(.*\) — и ничем другим$/\1/p' "projects/$n/README.md" | head -n1)
           echo "$n" > projects/.current; python3 nadzor.py task "проект $n: ${g:-$n}" >/dev/null
           say "Открыт проект $n. Клятва: ${g:-—}"; J "project use: $n";;
      list) cur=$(cat projects/.current 2>/dev/null); ls -d projects/*/ >/dev/null 2>&1 || { echo "проектов нет — wh project new <имя> \"<чем занимаюсь>\""; exit 0; }
           for d in projects/*/; do n=$(basename "$d"); g=$(sed -n 's/^Клятва: //p' "$d/README.md" | head -n1)
             printf '%s %-26s %s\n' "$([ "$n" = "$cur" ] && echo '▶' || echo ' ')" "$n" "$g"; done;;
      *) echo 'wh project new <имя> "<чем занимаюсь>" | use <имя> | list';;
    esac;;
  plan)   # wh plan <IP> — план работ для админа (что делаю / чего не делаю / данные / остановка)
    need "$1"; P="out/ПЛАН_$1_$TS.txt"
    cat > "$P" <<EOP
ПЛАН РАБОТ white_hat · $(date '+%d.%m.%Y %H:%M')
Объект: $1 (единственный адрес в области работ)          Связь с админом: ________________

ЧТО ДЕЛАЮ
 1. Сверка отпечатка ключа SSH (wh fp) — одно подключение, без входа.
 2. Сбор версий ПО и настроек (wh versions) — вход по выданной учётке, только команды чтения:
    список пакетов (dpkg-query / rpm), слушающие порты (ss -tln), запущенные службы,
    настройки SSH (sshd_config), версия ОС, имена учёток (без паролей). Файлов на сервере не создаю. ~1 мин.
 3. Проверка SSH (wh sshaudit) и HTTPS (wh tls) — обычные подключения, без атак.
 4. Сверка уязвимостей — у себя на ноутбуке (OSV.dev, trivy, grype). Сервер не нагружается.

ЧЕГО НЕ ДЕЛАЮ
 сканирование портов и сети · подбор паролей · нагрузку (DoS) · эксплуатацию уязвимостей ·
 установку и изменения на сервере · sudo · копирование баз и персональных данных

ДАННЫЕ
 Список пакетов и настроек хранится только у меня, отчёт — вам. Ничего не публикуется.

ОСТАНОВКА
 По первому слову администратора. При любой нестабильности сервиса — останавливаюсь сам.

КОНТРОЛЬ
 Каждое действие (моё и ИИ) пишется в журнал с цепочкой хэшей SHA-256. В конце — итоговый хэш вам.
 ИИ работает только через пульт: адреса — только из области; sudo, установка, сканеры — запрещены сторожем.

Согласовано: ____________________ (админ)        ____________________ (исполнитель)
EOP
    cat "$P"; J "plan: план работ по $1 -> $P";;
  go)     # wh go — МАСТЕР: всё по шагам, с вопросами; ничего не пропустить
    ask(){ local r; read -r -p "$1" r </dev/tty; echo "$r"; }
    yes(){ local a; a=$(ask "$1 (да/нет) "); case "$a" in да|д|y|yes) return 0;; *) return 1;; esac; }
    step(){ printf '\n\033[1;33m━━━━ %s ━━━━\033[0m\n' "$*"; }
    tell(){ printf '\033[1;35m  Скажи админу:\033[0m %s\n' "$*"; }
    J "go: мастер запущен"
    step "0/6 Готовность"
    miss=0; for t in trivy ssh-audit testssl.sh httpx ssh-keyscan; do command -v $t >/dev/null || { echo "  НЕТ инструмента: $t"; miss=1; }; done
    { [ -f tools/cache/kev.json ] && [ -d tools/cache/trivy ]; } || { echo "  НЕТ офлайн-баз — при интернете: wh update-db"; miss=1; }
    [ $miss = 0 ] && echo "  инструменты и офлайн-базы: ок"
    echo "  время на ноутбуке: $(date '+%d.%m.%Y %H:%M') — если неверное, скажи сразу (даты в журнале)"
    if [ -f "$KEY" ] && ssh-keygen -y -P "" -f "$KEY" >/dev/null 2>&1; then echo "  ВНИМАНИЕ: ключ SSH без пароля. Поставить (10 с): ssh-keygen -p -f $KEY"; fi
    if [ "$(curl -s -m 4 -o /dev/null -w '%{http_code}' https://api.osv.dev/v1/vulns/DSA-5000-1)" = 200 ]; then echo "  интернет: есть"; else export WH_OFFLINE=1; echo "  интернет: нет или плохой — сверка будет ОФЛАЙН (это нормально)"; fi
    yes "  Ноутбук на зарядке / заряжен?" || echo "  -> подключи зарядку"
    step "1/6 Адрес и данные от админа"
    tell "Мне нужен IP сервера (цифрами), порт SSH, имя сайта если есть, и согласие на план работ."
    while :; do ip=$(ask "  IP сервера (цифрами, например 10.1.2.3): ")
      python3 -c "import ipaddress,sys; n=ipaddress.ip_network(sys.argv[1],strict=False); sys.exit(0 if n.prefixlen>=24 else 1)" "$ip" 2>/dev/null && break
      echo "  это не IP или сеть шире /24. Дали имя сайта — попроси у админа IP; имя введёшь ниже."; done
    dom=$(ask "  Имя сайта на этом сервере (Enter — нет): ")
    port=$(ask "  Порт SSH (Enter — 22): "); [[ "$port" =~ ^[0-9]{1,5}$ ]] || port=22
    lg=$(ask "  Логин на сервер (Enter — логина нет): ")
    "$WH/wh" start "$ip" $lg
    step "2/6 План работ — показать админу"
    "$WH/wh" plan "$ip"
    tell "Вот план: только чтение, без сканирования и подбора паролей. Согласуем?"
    yes "  Админ согласовал (подпись или письменное «да»)?" || { echo "  СТОП: без согласования не начинаем. Это записано в журнал."; J "go: остановлено — план не согласован ($ip)"; exit 0; }
    J "go: план согласован админом ($ip)"
    step "3/6 Снаружи, без входа"
    tell "Сейчас только приветствие SSH и по одному запросу к сайту — как обычный посетитель."
    "$WH/wh" outside "$ip" "$port"
    [ -n "$dom" ] && "$WH/wh" web "$ip" "$dom"
    "$WH/wh" sshaudit "$ip" "$port"
    yes "  Проверить HTTPS (протоколы, сертификат, ~1–2 мин)?" && "$WH/wh" tls "$ip" 443 "$dom"
    if [ -n "$lg" ]; then
      step "4/6 Изнутри (дали логин)"
      "$WH/wh" fp "$ip" "$port"
      tell "Сверим отпечаток ключа сервера с вашим? Так исключаем подмену сервера."
      if yes "  Отпечаток совпал с тем, что назвал админ?"; then
        "$WH/wh" versions "$ip" "$lg" "$port" || { echo "  не вышло. Вручную (тоже только чтение):"; echo "    ssh -p $port $lg@$ip 'sh -s' < version.sh > out/v.txt && wh check --offline out/v.txt"; }
      else echo "  СТОП: отпечаток не совпал — не входим, зови админа."; J "go: отпечаток НЕ совпал ($ip) — вход отменён"; fi
    else step "4/6 Логина нет — проверку изнутри пропускаем"; fi
    step "5/6 Итог"
    "$WH/wh" report; [ -z "$WH_NO_OPEN" ] && "$WH/wh" open
    tell "Сверху — что срочно (уже атакуют), дальше — что обновить и какие настройки поправить. И хэш журнала — сохраните его."
    step "6/6 Хвосты"
    if yes "  Админ просит удалить выгрузки с ноутбука?"; then rm -f out/versions_"$ip"_* out/banner_"$ip"* out/web_"$ip"_*; echo "  удалено"; J "go: выгрузки $ip удалены по просьбе админа"; fi
    echo; echo "  Готово. Журнал: wh log · проверка цепочки: wh verify · отчёт: wh open";;
  about)  # wh about — схема «как работает» в браузере
    J "about: открыта схема"; (xdg-open "$WH/about.html" || firefox "$WH/about.html") >/dev/null 2>&1 &;;
  log)    python3 nadzor.py log "${1:-20}";;
  undo)   python3 nadzor.py undo;;
  verify) python3 nadzor.py verify;;
  report) # wh report — один итоговый файл: что сделано, результаты, хэш журнала
    say "Собираю итог и считаю хэш журнала — хэш остаётся у вас, после этого журнал нельзя тихо поменять."
    R="out/ИТОГ_$TS.md"; { echo "# white_hat — итог $(date '+%F %H:%M')"; echo; echo "Область: $(grep -v '^#' scope.txt | tr '\n' ' ')"; echo; echo "## Файлы результатов"; ls -1 out | sed 's/^/- /'; echo; echo "## Журнал (последние записи)"; echo '```'; python3 nadzor.py log 40; echo '```'; echo; echo "## Проверка журнала"; python3 nadzor.py verify; } > "$R"
    J "report: $R"; python3 nadzor.py verify; echo "итог: $R";;
  *) cat <<'EOF'
